# Copy to .env. Use only letters and digits in the password, it is part of MONGODB_URI.
MONGO_ROOT_USERNAME=app
MONGO_ROOT_PASSWORD=changeme

# Host ports; change them when several worktrees run containers at the same time
MONGO_PORT=27018
APP_PORT=3001

# Host ports of "make docker-dev": Vite and the Node inspector; also change them per worktree
WEB_PORT=5173
DEBUG_PORT=9229

# Encrypts the OIDC client secret in the database; generate with: openssl rand -hex 32
# Changing it means entering the client secret again.
AUTH_SECRET=changeme-generate-your-own

# Public address behind a TLS proxy, e.g. https://refill.example.org; https also marks the
# session cookie as Secure. Empty: derived from each request.
PUBLIC_URL=

# Used by "pnpm dev" on the host; the app container builds its own URI in docker-compose.yml
MONGODB_URI=mongodb://app:changeme@localhost:27018/consumption2refill?authSource=admin
