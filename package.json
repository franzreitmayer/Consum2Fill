{
  "name": "consumption2refill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "build": "pnpm -r build",
    "dev": "concurrently --names api,web \"pnpm --filter @c2r/api dev\" \"pnpm --filter @c2r/web dev\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
