{
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm --filter:*)",
      "Bash(make check)",
      "Bash(node scripts/remove-worktree.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose down:*)",
      "PowerShell(pnpm check)",
      "PowerShell(pnpm test:*)",
      "PowerShell(pnpm lint:*)",
      "PowerShell(pnpm typecheck:*)",
      "PowerShell(pnpm format:*)",
      "PowerShell(pnpm install:*)",
      "PowerShell(pnpm build:*)",
      "PowerShell(pnpm dev:*)",
      "PowerShell(pnpm --filter:*)",
      "PowerShell(make check)",
      "PowerShell(node scripts/remove-worktree.mjs:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git worktree:*)",
      "PowerShell(docker compose ps:*)",
      "PowerShell(docker compose logs:*)",
      "PowerShell(docker compose up:*)",
      "PowerShell(docker compose build:*)",
      "PowerShell(docker compose down:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(rm -r:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(docker compose down -v:*)",
      "PowerShell(docker compose down --volumes:*)",
      "PowerShell(docker system prune:*)",
      "PowerShell(docker volume rm:*)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  }
}
